###############################################################################
# NIMBUSCART - AWS INFRASTRUCTURE
#
# Architecture:
#
# Internet
#    |
#    v
# Web VPC (10.0.0.0/16)
#    |
#    +-- Public Subnet  -> Web EC2 + Nginx
#    |
#    +-- Private Subnet -> App EC2 + Docker
#                              |
#                              +--> NAT Gateway --> ECR
#                              |
#                              +--> VPC Peering
#                                      |
#                                      v
#                                Data VPC (10.1.0.0/16)
#                                      |
#                                      v
#                                RDS PostgreSQL
#
###############################################################################


###############################################################################
# PROVIDER
###############################################################################

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}


###############################################################################
# DATA SOURCES
###############################################################################

data "aws_availability_zones" "available" {
  state = "available"
}

data "aws_caller_identity" "current" {}

data "aws_ami" "ubuntu" {
  most_recent = true

  owners = ["099720109477"]

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }

  filter {
    name   = "architecture"
    values = ["x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}


###############################################################################
# LOCALS
###############################################################################

locals {
  az1 = data.aws_availability_zones.available.names[0]
  az2 = data.aws_availability_zones.available.names[1]

  web_vpc_cidr  = "10.0.0.0/16"
  data_vpc_cidr = "10.1.0.0/16"

  web_public_subnet_cidr  = "10.0.1.0/24"
  app_private_subnet_cidr = "10.0.2.0/24"

  db_private_subnet_1_cidr = "10.1.0.0/24"
  db_private_subnet_2_cidr = "10.1.1.0/24"

  ecr_repository_url = aws_ecr_repository.api.repository_url

  common_tags = {
    Project   = var.project_name
    ManagedBy = "Terraform"
  }
}


###############################################################################
# WEB VPC
###############################################################################

resource "aws_vpc" "web" {
  cidr_block           = local.web_vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-web-vpc"
      Tier = "web"
    }
  )
}


###############################################################################
# DATA VPC
###############################################################################

resource "aws_vpc" "data" {
  cidr_block           = local.data_vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-data-vpc"
      Tier = "data"
    }
  )
}


###############################################################################
# INTERNET GATEWAY
###############################################################################

resource "aws_internet_gateway" "web" {
  vpc_id = aws_vpc.web.id

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-igw"
    }
  )
}


###############################################################################
# WEB PUBLIC SUBNET
###############################################################################

resource "aws_subnet" "web_public" {
  vpc_id                  = aws_vpc.web.id
  cidr_block              = local.web_public_subnet_cidr
  availability_zone       = local.az1
  map_public_ip_on_launch = true

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-web-public"
      Tier = "web"
    }
  )
}


###############################################################################
# APP PRIVATE SUBNET
###############################################################################

resource "aws_subnet" "app_private" {
  vpc_id            = aws_vpc.web.id
  cidr_block        = local.app_private_subnet_cidr
  availability_zone = local.az1

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-app-private"
      Tier = "app"
    }
  )
}


###############################################################################
# DATA PRIVATE SUBNET 1
###############################################################################

resource "aws_subnet" "db_private_1" {
  vpc_id            = aws_vpc.data.id
  cidr_block        = local.db_private_subnet_1_cidr
  availability_zone = local.az1

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-db-private-1"
      Tier = "data"
    }
  )
}


###############################################################################
# DATA PRIVATE SUBNET 2
###############################################################################

resource "aws_subnet" "db_private_2" {
  vpc_id            = aws_vpc.data.id
  cidr_block        = local.db_private_subnet_2_cidr
  availability_zone = local.az2

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-db-private-2"
      Tier = "data"
    }
  )
}


###############################################################################
# WEB PUBLIC ROUTE TABLE
###############################################################################

resource "aws_route_table" "web_public" {
  vpc_id = aws_vpc.web.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.web.id
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-web-public-rt"
    }
  )
}


###############################################################################
# WEB PUBLIC ROUTE ASSOCIATION
###############################################################################

resource "aws_route_table_association" "web_public" {
  subnet_id      = aws_subnet.web_public.id
  route_table_id = aws_route_table.web_public.id
}


###############################################################################
# NAT ELASTIC IP
###############################################################################

resource "aws_eip" "nat" {
  domain = "vpc"

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-nat-eip"
    }
  )
}


###############################################################################
# NAT GATEWAY
###############################################################################

resource "aws_nat_gateway" "web" {
  allocation_id = aws_eip.nat.id
  subnet_id     = aws_subnet.web_public.id

  depends_on = [
    aws_internet_gateway.web
  ]

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-nat"
    }
  )
}


###############################################################################
# APP PRIVATE ROUTE TABLE
###############################################################################

resource "aws_route_table" "app_private" {
  vpc_id = aws_vpc.web.id

  # Internet access for private App EC2 through NAT
  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.web.id
  }

  # Route from App VPC to Data VPC through peering
  route {
    cidr_block                = local.data_vpc_cidr
    vpc_peering_connection_id = aws_vpc_peering_connection.web_to_data.id
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-app-private-rt"
    }
  )
}


###############################################################################
# APP PRIVATE ROUTE ASSOCIATION
###############################################################################

resource "aws_route_table_association" "app_private" {
  subnet_id      = aws_subnet.app_private.id
  route_table_id = aws_route_table.app_private.id
}


###############################################################################
# DATA VPC ROUTE TABLE
###############################################################################

resource "aws_route_table" "data_private" {
  vpc_id = aws_vpc.data.id

  # Return traffic from Data VPC to Web/App VPC
  route {
    cidr_block                = local.web_vpc_cidr
    vpc_peering_connection_id = aws_vpc_peering_connection.web_to_data.id
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-data-private-rt"
    }
  )
}


###############################################################################
# DATA SUBNET 1 ROUTE ASSOCIATION
###############################################################################

resource "aws_route_table_association" "db_private_1" {
  subnet_id      = aws_subnet.db_private_1.id
  route_table_id = aws_route_table.data_private.id
}


###############################################################################
# DATA SUBNET 2 ROUTE ASSOCIATION
###############################################################################

resource "aws_route_table_association" "db_private_2" {
  subnet_id      = aws_subnet.db_private_2.id
  route_table_id = aws_route_table.data_private.id
}


###############################################################################
# VPC PEERING
###############################################################################

resource "aws_vpc_peering_connection" "web_to_data" {
  vpc_id      = aws_vpc.web.id
  peer_vpc_id = aws_vpc.data.id
  auto_accept = true

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-web-to-data-peering"
    }
  )
}


###############################################################################
# WEB SECURITY GROUP
###############################################################################

resource "aws_security_group" "web" {
  name        = "${var.project_name}-web-sg"
  description = "Security group for NimbusCart Web EC2"
  vpc_id      = aws_vpc.web.id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH administration"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.admin_cidr]
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-web-sg"
      Tier = "web"
    }
  )
}


###############################################################################
# APP SECURITY GROUP
###############################################################################

resource "aws_security_group" "app" {
  name        = "${var.project_name}-app-sg"
  description = "Security group for NimbusCart App EC2"
  vpc_id      = aws_vpc.web.id

  ingress {
    description     = "API traffic from Web tier"
    from_port       = 5000
    to_port         = 5000
    protocol        = "tcp"
    security_groups = [aws_security_group.web.id]
  }

  ingress {
    description     = "SSH from Web jump host"
    from_port       = 22
    to_port         = 22
    protocol        = "tcp"
    security_groups = [aws_security_group.web.id]
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-app-sg"
      Tier = "app"
    }
  )
}


###############################################################################
# RDS SECURITY GROUP
###############################################################################

resource "aws_security_group" "db" {
  name        = "${var.project_name}-db-sg"
  description = "Security group for NimbusCart RDS"
  vpc_id      = aws_vpc.data.id

  ingress {
    description = "PostgreSQL from App tier"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"

    cidr_blocks = [
      local.app_private_subnet_cidr
    ]
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-db-sg"
      Tier = "data"
    }
  )
}


###############################################################################
# ECR REPOSITORY
###############################################################################

resource "aws_ecr_repository" "api" {
  name                 = "${var.project_name}-api"
  image_tag_mutability = "MUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-api"
    }
  )
}


###############################################################################
# ECR LIFECYCLE POLICY
###############################################################################

resource "aws_ecr_lifecycle_policy" "api" {
  repository = aws_ecr_repository.api.name

  policy = jsonencode({
    rules = [
      {
        rulePriority = 1

        description = "Keep only the latest 5 images"

        selection = {
          tagStatus   = "any"
          countType   = "imageCountMoreThan"
          countNumber = 5
        }

        action = {
          type = "expire"
        }
      }
    ]
  })
}


###############################################################################
# IAM ROLE FOR APP EC2
###############################################################################

resource "aws_iam_role" "app" {
  name = "${var.project_name}-app-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"

    Statement = [
      {
        Effect = "Allow"

        Principal = {
          Service = "ec2.amazonaws.com"
        }

        Action = "sts:AssumeRole"
      }
    ]
  })

  tags = local.common_tags
}


###############################################################################
# IAM POLICY FOR ECR ACCESS
###############################################################################

resource "aws_iam_role_policy" "app_ecr" {
  name = "${var.project_name}-ecr-policy"
  role = aws_iam_role.app.id

  policy = jsonencode({
    Version = "2012-10-17"

    Statement = [
      {
        Effect = "Allow"

        Action = [
          "ecr:GetAuthorizationToken"
        ]

        Resource = "*"
      },
      {
        Effect = "Allow"

        Action = [
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchGetImage"
        ]

        Resource = aws_ecr_repository.api.arn
      }
    ]
  })
}


###############################################################################
# IAM INSTANCE PROFILE
###############################################################################

resource "aws_iam_instance_profile" "app" {
  name = "${var.project_name}-app-profile"
  role = aws_iam_role.app.name

  tags = local.common_tags
}


###############################################################################
# DB SUBNET GROUP
###############################################################################

resource "aws_db_subnet_group" "nimbuscart" {
  name = "${var.project_name}-db-subnet-group"

  subnet_ids = [
    aws_subnet.db_private_1.id,
    aws_subnet.db_private_2.id
  ]

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-db-subnet-group"
    }
  )
}


###############################################################################
# RDS POSTGRESQL
###############################################################################

resource "aws_db_instance" "nimbuscart" {
  identifier = "${var.project_name}-postgres"

  engine         = "postgres"
  engine_version = "17"

  instance_class = "db.t3.micro"

  allocated_storage     = 20
  max_allocated_storage = 50
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = var.db_password

  port = 5432

  db_subnet_group_name = aws_db_subnet_group.nimbuscart.name

  vpc_security_group_ids = [
    aws_security_group.db.id
  ]

  publicly_accessible = false

  multi_az = false

  backup_retention_period = 1

  skip_final_snapshot = true

  deletion_protection = false

  apply_immediately = true

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-postgres"
      Tier = "data"
    }
  )
}


###############################################################################
# APP EC2
###############################################################################

resource "aws_instance" "app" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = var.instance_type

  subnet_id = aws_subnet.app_private.id

  vpc_security_group_ids = [
    aws_security_group.app.id
  ]

  key_name = var.key_name

  iam_instance_profile = aws_iam_instance_profile.app.name

  associate_public_ip_address = false

  user_data = <<-EOF
    #!/bin/bash
    set -e

    echo "=== NimbusCart App EC2 bootstrap started ==="

    apt-get update
    apt-get install -y docker.io awscli

    systemctl enable docker
    systemctl start docker

    echo "=== Logging into ECR ==="

    aws ecr get-login-password --region ${var.aws_region} | \
      docker login \
        --username AWS \
        --password-stdin ${aws_ecr_repository.api.repository_url}

    echo "=== Pulling API image ==="

    docker pull ${aws_ecr_repository.api.repository_url}:latest

    echo "=== Removing old container ==="

    docker rm -f nimbuscart-api 2>/dev/null || true

    echo "=== Starting NimbusCart API ==="

    docker run -d \
      --name nimbuscart-api \
      --restart unless-stopped \
      -p 5000:5000 \
      -e PORT=5000 \
      -e DB_HOST="${aws_db_instance.nimbuscart.address}" \
      -e DB_PORT="5432" \
      -e DB_NAME="${var.db_name}" \
      -e DB_USER="${var.db_username}" \
      -e DB_PASSWORD="${var.db_password}" \
      ${aws_ecr_repository.api.repository_url}:latest

    echo "=== App container started ==="

    docker ps

    echo "=== NimbusCart App bootstrap completed ==="
  EOF

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-app"
      Tier = "app"
    }
  )

  depends_on = [
    aws_db_instance.nimbuscart,
    aws_ecr_repository.api,
    aws_iam_role_policy.app_ecr,
    aws_nat_gateway.web,
    aws_route_table.app_private
  ]
}


###############################################################################
# WEB EC2
###############################################################################

resource "aws_instance" "web" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = var.instance_type

  subnet_id = aws_subnet.web_public.id

  vpc_security_group_ids = [
    aws_security_group.web.id
  ]

  associate_public_ip_address = true

  key_name = var.key_name

  provisioner "file" {
    source      = "../app/frontend"
    destination = "/tmp/frontend"

    connection {
      type        = "ssh"
      user        = "ubuntu"
      private_key = file(var.ssh_private_key_path)
      host        = self.public_ip
    }
  }

  provisioner "file" {
    source      = "config/nimbuscart.conf"
    destination = "/tmp/nimbuscart.conf"

    connection {
      type        = "ssh"
      user        = "ubuntu"
      private_key = file(var.ssh_private_key_path)
      host        = self.public_ip
    }
  }

  provisioner "remote-exec" {
    inline = [
      "echo '=== Installing Nginx ==='",
      "sudo apt-get update",
      "sudo apt-get install -y nginx",

      "echo '=== Creating frontend directory ==='",
      "sudo rm -rf /var/www/nimbuscart",
      "sudo mkdir -p /var/www/nimbuscart",

      "echo '=== Copying frontend ==='",
      "sudo cp -r /tmp/frontend/* /var/www/nimbuscart/",

      "echo '=== Configuring Nginx ==='",
      "sudo sed -i 's|APP_PRIVATE_IP|${aws_instance.app.private_ip}|g' /tmp/nimbuscart.conf",

      "sudo cp /tmp/nimbuscart.conf /etc/nginx/sites-available/nimbuscart",

      "sudo rm -f /etc/nginx/sites-enabled/default",

      "sudo ln -sf /etc/nginx/sites-available/nimbuscart /etc/nginx/sites-enabled/nimbuscart",

      "sudo chown -R www-data:www-data /var/www/nimbuscart",
      "sudo chmod -R 755 /var/www/nimbuscart",

      "echo '=== Testing Nginx configuration ==='",
      "sudo nginx -t",

      "sudo systemctl enable nginx",
      "sudo systemctl restart nginx",

      "echo '=== Nginx deployment completed ==='",
      "sudo systemctl --no-pager status nginx"
    ]

    connection {
      type        = "ssh"
      user        = "ubuntu"
      private_key = file(var.ssh_private_key_path)
      host        = self.public_ip
    }
  }

  tags = merge(
    local.common_tags,
    {
      Name = "${var.project_name}-web"
      Tier = "web"
    }
  )

  depends_on = [
    aws_instance.app,
    aws_route_table_association.web_public
  ]
}


###############################################################################
# END OF MAIN.TF
###############################################################################
